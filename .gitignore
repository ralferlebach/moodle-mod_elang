# OS artefacts
.DS_Store
Thumbs.db
desktop.ini
*Zone.Identifier

# IDE
.idea/
.vscode/
*.iml
*.iws

# Node
node_modules/
npm-debug.log*
yarn-error.log*
# package-lock.json IS committed: it pins the dev toolchain so `npm ci`
# reproduces the exact esbuild/grunt versions that built the shipped bundles.
yarn.lock

# PHP / Composer
# Anchored to the plugin root so it only ignores the Composer vendor/ directory,
# NOT js/vendor/ (the committed React bundle lives there — an unanchored
# "vendor/" would silently exclude it from the repository and break CI).
/vendor/
composer.lock

# moodle-plugin-ci working directories
ci/
moodle/

# PHPUnit / coverage
.phpunit.result.cache
.phpunit.cache/
coverage/
*.clover

# Behat screenshots
behatfaildumps/

# Temporary / backup files
*.bak
*.tmp
*.swp
*~

# Local developer overrides
.env
.env.local

# AMD build artefacts: these ARE committed. Moodle serves them at runtime and
# the CI validates them from the repo. The amd/src sources build their .min.js
# via Grunt (editor.min.js, player.min.js). The prebuilt React authoring bundle
# is NOT here — it lives at js/vendor/react/editor.bundle.js (built by esbuild
# via build.mjs) because moodle-plugin-ci wipes amd/build/ before re-running
# Grunt and flags any file Grunt cannot regenerate. Both amd/build/ and
# js/vendor/react/ must be committed.
# (Intentionally NOT ignoring amd/build/ or js/vendor/.)

# E5/E6 load & browser test artefacts (downloaded binaries / generated results).
/tests/load/apache-jmeter-*/
/tests/load/k6
/tests/load/*.jtl
/tests/load/.load-env
/tests/load/*.log
/tests/playwright/playwright-report/
/tests/playwright/test-results/
# tests/playwright/package-lock.json IS committed, like the plugin's own.
# It was ignored while the browser tests were a local-only tool; now that CI
# runs them, `npm ci` needs it and fails outright without one:
#   "The `npm ci` command can only install with an existing package-lock.json".
# Pinning it also means a Playwright release cannot silently change what the
# scheduled run tests.

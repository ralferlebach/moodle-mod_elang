{
  "name": "mod_elang-editor",
  "version": "2.0.0",
  "description": "eLang authoring editor frontend (React/TypeScript). Build tooling is development-only; the production server ships the prebuilt bundle and needs no Node/npm.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/js/tests/**/*.test.ts",
      "**/js/tests/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/js/tests/setup.ts"
    ]
  }
}

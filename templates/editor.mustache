{{!
    @template mod_elang/editor

    Moodle-native shell for the exercise content editor. The mod_elang/editor
    AMD module mounts the bundled React application into the editorroot region,
    replacing the server-rendered loading status; the media upload page URL is
    handed over as a data attribute.

    Example context (json):
    {
        "mediauploadurl": "https://example.com/mod/elang/media.php?id=1"
    }
}}
<div class="mod_elang-editor" data-region="mod_elang/editor">
    <h3>{{#str}} editor:heading, mod_elang {{/str}}</h3>

    <div data-region="editorroot" data-mediauploadurl="{{mediauploadurl}}">
        <p class="mod_elang-status" data-region="status" role="status" aria-live="polite">
            {{#str}} editor:loading, mod_elang {{/str}}
        </p>
    </div>
</div>

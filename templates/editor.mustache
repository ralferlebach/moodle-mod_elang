{{!
    @template mod_elang/editor

    Moodle-native shell for the exercise content editor. The mod_elang/editor
    AMD module loads the draft through the external API and renders the cue rows
    into the cues region; the status region is an aria-live area the module
    writes progress and errors into.

    Example context (json):
    {
    }
}}
<div class="mod_elang-editor" data-region="mod_elang/editor">
    <h3>{{#str}} editor:heading, mod_elang {{/str}}</h3>

    <p class="mod_elang-status" data-region="status" role="status" aria-live="polite">
        {{#str}} editor:loading, mod_elang {{/str}}
    </p>

    <div class="mod_elang-editor-toolbar mb-3">
        <button type="button" class="btn btn-primary" data-action="save">
            {{#str}} editor:save, mod_elang {{/str}}
        </button>
        <button type="button" class="btn btn-success" data-action="publish">
            {{#str}} editor:publish, mod_elang {{/str}}
        </button>
        <button type="button" class="btn btn-secondary" data-action="addcue">
            {{#str}} editor:addcue, mod_elang {{/str}}
        </button>
    </div>

    <div class="mod_elang-editor-timeline-wrap mb-3" data-region="timelinewrap">
        <video class="mod_elang-editor-media-preview" data-region="mediapreview" controls preload="metadata" hidden></video>
        <div class="mod_elang-editor-timeline" data-region="timeline"></div>
    </div>

    <details class="mod_elang-editor-import mb-3">
        <summary>{{#str}} editor:import, mod_elang {{/str}}</summary>
        <p class="text-muted">{{#str}} editor:importhint, mod_elang {{/str}}</p>
        <textarea class="form-control" rows="4" data-region="importtext"
                  aria-label="{{#str}} editor:import, mod_elang {{/str}}"></textarea>
        <button type="button" class="btn btn-secondary mt-2" data-action="import">
            {{#str}} editor:import, mod_elang {{/str}}
        </button>
    </details>

    <details class="mod_elang-editor-media mb-3">
        <summary>{{#str}} editor:media, mod_elang {{/str}}</summary>
        <p class="text-muted" data-region="currentmedia"></p>
        <div class="form-group">
            <label class="d-block">{{#str}} editor:mediakind, mod_elang {{/str}}
                <select class="form-control" data-region="mediakind">
                    <option value="">{{#str}} editor:medianone, mod_elang {{/str}}</option>
                    <option value="url">{{#str}} editor:mediaurl, mod_elang {{/str}}</option>
                    <option value="provider">{{#str}} editor:mediaprovider, mod_elang {{/str}}</option>
                </select>
            </label>
        </div>
        <div class="form-group" data-region="mediaurlfield">
            <label class="d-block">{{#str}} editor:mediaurl, mod_elang {{/str}}
                <input type="url" class="form-control" data-region="mediaurlinput">
            </label>
        </div>
        <div class="form-group" data-region="mediaproviderfields">
            <label class="d-block">{{#str}} editor:mediaprovider, mod_elang {{/str}}
                <input type="text" class="form-control" data-region="mediaproviderinput">
            </label>
            <label class="d-block">{{#str}} editor:mediaproviderref, mod_elang {{/str}}
                <input type="text" class="form-control" data-region="mediaproviderrefinput">
            </label>
        </div>
        <button type="button" class="btn btn-secondary" data-action="savemedia">
            {{#str}} editor:savemedia, mod_elang {{/str}}
        </button>
        {{#mediauploadurl}}
            <p class="mt-2">
                <a href="{{mediauploadurl}}">{{#str}} editor:uploadmedia, mod_elang {{/str}}</a>
            </p>
        {{/mediauploadurl}}
    </details>

    <div class="mod_elang-editor-cues" data-region="cues"></div>
</div>

{{!
    @template mod_elang/player

    Moodle-native shell for the language-exercise player. The mod_elang/player
    AMD module populates the media and transcript regions from the external
    API once the attempt has started; the status region is an aria-live area
    the module writes progress and errors into.

    Example context (json):
    {
    }
}}
<div class="mod_elang-player" data-region="mod_elang/player">
    <div class="mod_elang-media" data-region="media"></div>

    <p class="mod_elang-status" data-region="status" role="status" aria-live="polite">
        {{#str}} player:loading, mod_elang {{/str}}
    </p>

    <section class="mod_elang-transcript" data-region="transcript"
             aria-label="{{#str}} player:transcriptheading, mod_elang {{/str}}">
    </section>
</div>
